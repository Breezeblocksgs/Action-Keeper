    }
  ],
  "url": "https://github.com/Breezeblocksgs/Action-Keeper",
  "manifest": "https://github.com/Breezeblocksgs/Action-Keeper/releases/latest/download/module.json",
  "download": "https://github.com/Breezeblocksgs/Action-Keeper/releases/download/v1.0.0/action-keeper.zip",
  "bugs": "https://github.com/Breezeblocksgs/Action-Keeper/issues",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "relationships": {
