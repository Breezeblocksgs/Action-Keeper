{
  "id": "action-keeper",
  "type": "module",
  "title": "Action Keeper",
  "description": "A compact, player-only action tracker that helps each player manually track Main Action, Bonus Action, Reaction, and Movement availability during combat. Does not automate action detection.",
  "version": "1.0.0",
  "authors": [
    {
      "name": "Pedro Henrique Cesar Godoi Braz",
