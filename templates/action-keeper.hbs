<div class="action-keeper-panel">
  {{#unless hasToken}}
    <p class="action-keeper-empty">{{i18n.noToken}}</p>
  {{/unless}}

  {{#if hasToken}}
    <div class="action-keeper-token-header">
      {{#if tokenHeader.img}}
        <img src="{{tokenHeader.img}}" alt="" class="action-keeper-token-portrait">
      {{/if}}
      <span class="action-keeper-token-name">{{tokenHeader.name}}</span>
    </div>

    {{#unless inCombat}}
      <p class="action-keeper-empty">{{i18n.notInCombat}}</p>
    {{/unless}}

    <div class="action-keeper-groups">
      {{#each groups as |group|}}
        <fieldset class="action-keeper-group" style="--ak-color: {{group.color}}">
          <legend>
            <i class="{{group.icon}}" aria-hidden="true"></i>
            {{group.label}}
          </legend>
          <div class="action-keeper-slots">
            {{#each group.slots as |slot|}}
              <button type="button"
                      class="action-keeper-slot {{#if slot.available}}is-available{{else}}is-used{{/if}} {{#unless ../../labeledButtons}}is-compact{{/unless}}"
                      data-action="toggleSlot"
                      data-group="{{group.key}}"
                      data-index="{{slot.index}}"
                      aria-pressed="{{slot.available}}"
                      aria-label="{{slot.label}}">
                {{#if ../../labeledButtons}}
                  <i class="{{group.icon}}" aria-hidden="true"></i>
                  <span class="action-keeper-slot-status">{{slot.statusLabel}}</span>
                {{/if}}
              </button>
            {{/each}}
          </div>
        </fieldset>
      {{/each}}
    </div>
  {{/if}}

  <div class="action-keeper-footer">
    <button type="button"
            class="action-keeper-settings-toggle"
            data-action="toggleSettingsPanel"
            aria-expanded="{{settingsOpen}}"
            aria-label="{{i18n.configureButton}}">
      <i class="fa-solid fa-gear" aria-hidden="true"></i>
      {{i18n.configureButton}}
    </button>
  </div>

  {{#if settingsOpen}}
    <div class="action-keeper-settings">
      {{#if hasToken}}
        {{#each groups as |group|}}
          <label class="action-keeper-count-label" for="ak-count-{{group.key}}">{{group.label}}</label>
          <select id="ak-count-{{group.key}}" class="action-keeper-count-select" data-setting="count" data-group="{{group.key}}">
            {{#each group.countOptions as |option|}}
              <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.value}}</option>
            {{/each}}
          </select>
        {{/each}}
      {{/if}}
    </div>
  {{/if}}
</div>
