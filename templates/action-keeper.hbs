<div class="action-keeper-panel">
  {{#unless hasActiveCombat}}
    <p class="action-keeper-empty">{{localize "ACTION_KEEPER.NoActiveCombat"}}</p>
  {{/unless}}

  <div class="action-keeper-groups">
    {{#each groups as |group|}}
      <fieldset class="action-keeper-group" style="--ak-color: {{group.color}}">
        <legend>
          <i class="{{group.icon}}" aria-hidden="true"></i>
          {{group.label}}
        </legend>
        <div class="action-keeper-slots">
          {{#each group.slots as |slot|}}
            <button type="button"
                    class="action-keeper-slot {{#if slot.available}}is-available{{else}}is-used{{/if}} {{#unless ../../labeledButtons}}is-compact{{/unless}}"
                    data-action="toggleSlot"
                    data-group="{{group.key}}"
                    data-index="{{slot.index}}"
                    aria-pressed="{{slot.available}}"
                    aria-label="{{slot.label}}"
                    {{#unless ../../hasActiveCombat}}disabled{{/unless}}>
              {{#if ../../labeledButtons}}
                <i class="{{group.icon}}" aria-hidden="true"></i>
                <span class="action-keeper-slot-status">{{slot.statusLabel}}</span>
              {{/if}}
            </button>
          {{/each}}
        </div>
      </fieldset>
    {{/each}}
  </div>

  <div class="action-keeper-footer">
    <button type="button"
            class="action-keeper-settings-toggle"
            data-action="toggleSettingsPanel"
            aria-expanded="{{settingsOpen}}"
            aria-label="{{localize 'ACTION_KEEPER.ConfigureButton'}}">
      <i class="fa-solid fa-gear" aria-hidden="true"></i>
      {{localize "ACTION_KEEPER.ConfigureButton"}}
    </button>
  </div>

  {{#if settingsOpen}}
    <div class="action-keeper-settings">
      {{#each groups as |group|}}
        <label class="action-keeper-count-field">
          <span>{{group.label}}</span>
          <select data-setting="count" data-group="{{group.key}}">
            {{#each group.countOptions as |option|}}
              <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.value}}</option>
            {{/each}}
          </select>
        </label>
      {{/each}}

      <label class="action-keeper-checkbox-field">
        <input type="checkbox" data-action="toggleAutoOpen" {{#if autoOpen}}checked{{/if}}>
        {{localize "ACTION_KEEPER.AutoOpen"}}
      </label>

      <label class="action-keeper-checkbox-field">
        <input type="checkbox" data-action="toggleAutoClose" {{#if autoClose}}checked{{/if}}>
        {{localize "ACTION_KEEPER.AutoClose"}}
      </label>

      <label class="action-keeper-checkbox-field">
        <input type="checkbox" data-action="toggleLabeledButtons" {{#if labeledButtons}}checked{{/if}}>
        {{localize "ACTION_KEEPER.LabeledButtons"}}
      </label>
    </div>
  {{/if}}
</div>
